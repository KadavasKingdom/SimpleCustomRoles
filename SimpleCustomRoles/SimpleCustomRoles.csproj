<Project Sdk="Microsoft.NET.Sdk">

	<!-- Settable (Version, etc) -->
	<PropertyGroup>
		<RepositoryUrl>https://github.com/KadavasKingdom/SimpleCustomRoles</RepositoryUrl>
		<PackageProjectUrl>https://github.com/KadavasKingdom/SimpleCustomRoles</PackageProjectUrl>
		<Authors>KadavasKingdom</Authors>
		<Copyright>(c) 2025-2026 KadavasKingdom</Copyright>
		<Version>0.0.1</Version>
		<FileVersion>$(Verion)</FileVersion>
		<DateAndTime>$([System.DateTime]::UtcNow.ToString('yy'))$([System.DateTime]::UtcNow.DayOfYear.ToString('000'))$([System.DateTime]::UtcNow.ToString('HHmm'))</DateAndTime>
		<PackageVersion>$(Version).$(DateAndTime)</PackageVersion>
		<PackageId>KadavasKingdom.SimpleCustomRoles</PackageId>
		<PackageTags>scpsl;labapi;labapi-plugin</PackageTags>
	</PropertyGroup>
	
	<!-- Nuget References -->
	<ItemGroup>
	  <PackageReference Include="KadavasKingdom.LabApiExtensions" Version="0.4.1.263071534" />
	  <PackageReference Include="Lib.Harmony" Version="2.4.3" />
	</ItemGroup>

	<!-- DLL References -->
	<ItemGroup>
		<Reference Include="Assembly-CSharp" Publicize="true" Private="false" />
		<Reference Include="Assembly-CSharp-firstpass" Private="false" />
		<Reference Include="CommandSystem.Core" Private="false" />
		<Reference Include="Mirror" Publicize="true" Private="false" />
		<Reference Include="NorthwoodLib" Private="false" />
		<Reference Include="Pooling" Private="false" />
		<Reference Include="UnityEngine.PhysicsModule" Private="false" />
		<Reference Include="YamlDotNet" Private="false" />
	</ItemGroup>
</Project>
